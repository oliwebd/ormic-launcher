{
  "name": "ormic-launcher",
  "version": "0.1.6",
  "description": "Ormic Launcher GNOME Extension in TypeScript",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && prettier --write 'dist/**/*.js' && node scripts/format-dist.mjs",
    "local-install": "make install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@girs/gjs": "4.0.0-rc.15",
    "@girs/gnome-shell": "^50.0.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4"
  }
}